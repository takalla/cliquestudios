{
  // "name" must exactly match the Worker's name in the Cloudflare dashboard
  // (Workers & Pages > cliquestudios), or Workers Builds will fail.
  "name": "cliquestudios",
  "compatibility_date": "2026-08-27",
  "assets": {
    // This is a plain static site (no build step) -- index.html, 404.html,
    // css/, js/ all live at the repo root, so serve straight from here.
    "directory": ".",
    // Explicitly serve 404.html (with a 404 status) for any path that
    // doesn't match a real file. Not automatic for Workers static assets
    // the way it was on classic Cloudflare Pages -- must be set.
    "not_found_handling": "404-page"
  }
}
